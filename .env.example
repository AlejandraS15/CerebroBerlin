# ─────────────────────────────────────────────────────────────
# Gemelo Digital de Berlín — Variables de entorno (todas OPCIONALES)
# La app funciona SIN ninguna key gracias a la capa de datos mock.
# Copia este archivo a ".env.local" y rellena las que quieras usar.
# ─────────────────────────────────────────────────────────────

# --- Mapa base ---
# MapLibre usa por defecto un estilo abierto (OSM / demotiles), NO requiere token.
# Si prefieres un estilo propio (Mapbox/MapTiler), define su URL de estilo aquí:
NEXT_PUBLIC_MAP_STYLE_URL=

# --- APIs de datos abiertos (opcionales) ---
# VBB / BVG — Transporte público (transport.rest es un wrapper público del HAFAS de VBB)
NEXT_PUBLIC_VBB_API_BASE=https://v6.vbb.transport.rest

# OpenAQ — Calidad del aire
NEXT_PUBLIC_OPENAQ_API_BASE=https://api.openaq.org/v3
# OPENAQ_API_KEY=

# Portal de Datos Abiertos de Berlín (CKAN)
NEXT_PUBLIC_BERLIN_OPENDATA_BASE=https://datenregister.berlin.de/api/3

# GBFS — Bicicletas/scooters compartidos (Nextbike Berlín como ejemplo)
NEXT_PUBLIC_GBFS_URL=https://gbfs.nextbike.net/maps/gbfs/v2/nextbike_bn/gbfs.json

# --- Comportamiento ---
# "true" fuerza el uso de datos mock aunque haya red (útil para desarrollo/offline)
NEXT_PUBLIC_USE_MOCK_DATA=false
